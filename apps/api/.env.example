PROJECT_NAME="ArenaGo API"
ENVIRONMENT="development"
SECRET_KEY="arenago_super_jwt_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Para SQLite local: sqlite+aiosqlite:///./arenago.db
# Para PostgreSQL: postgresql+asyncpg://arenago_user:arenago_secret_password@localhost:5432/arenago_db
DATABASE_URL="sqlite+aiosqlite:///./arenago.db"

# Redis (opcional em dev local, usa fallback em memoria)
REDIS_URL="redis://localhost:6379/0"

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
